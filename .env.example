# Supabase Dashboard -> Connect -> ORMs -> Prisma
# Use the pooled Prisma connection string for hosted/serverless deployments.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[DATABASE-PASSWORD]@[POOLER-HOST]:6543/postgres?pgbouncer=true&sslmode=require"
SESSION_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL="admin@egymedya.com"
ADMIN_PASSWORD="change-this-before-deploying"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_replace-me"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"